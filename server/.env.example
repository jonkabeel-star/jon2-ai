# Copy these values into the backend host's secret/environment settings.
# Do not commit a real .env file or real credentials to GitHub.

NODE_ENV=production
PORT=3000
TRUST_PROXY=false

# HTTPS API origin, without a trailing slash.
JON2_API_PUBLIC_URL=https://YOUR-API-HOST.example
# Public frontend origin (not a path).
JON2_ALLOWED_ORIGINS=https://jonkabeel-star.github.io
JON2_FRONTEND_URL=https://jonkabeel-star.github.io/jon2-ai

# Managed PostgreSQL connection string. Keep this private.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PGSSL=require

# SMTP credentials from a transactional email provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASS=YOUR_SMTP_PASSWORD
EMAIL_FROM=Jon2 AI <no-reply@example.com>

# Optional model endpoint. Keep it server-side; never expose it in the website.
AI_MODEL_URL=https://YOUR-MODEL-HOST.example/api/chat
