# Private training assets must remain outside the public checkout. These rules
# protect future untracked files only; tracked files require a separate owner decision.
/private-data/
/ai_engine/private-data/
/ai_engine/training_data/private/
/ai_engine/training_data/source_approvals.json
/ai_engine/training_data/*.local.json
/ai_engine/checkpoints/
/ai_engine/evaluation/*.json
